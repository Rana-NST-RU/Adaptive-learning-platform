# Copy to apps/web/.env.local and fill in.

# PostgreSQL 15+ with the pgvector extension available
DATABASE_URL=postgres://localhost:5432/alp_dev

# Session signing secret (any long random string: `openssl rand -base64 32`)
AUTH_SECRET=change-me

# Claude: agents are disabled when no credential is found and the app falls
# back to the seeded item bank. The SDK also picks up `ant auth login`.
ANTHROPIC_API_KEY=
# Model for all agents; per-agent override with ALP_MODEL_<AGENT>, e.g. ALP_MODEL_VERIFIER
ALP_MODEL=claude-opus-5-5
# Per-learner daily token budget for agent calls
ALP_DAILY_TOKEN_BUDGET=400000

# Optional: embeddings for RAG (hybrid retrieval falls back to full-text search when unset)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Optional: let the Curriculum Architect use Claude's web search when no material is uploaded
# (must also be enabled for your organisation in the Claude Console)
ALP_WEB_SEARCH=off
